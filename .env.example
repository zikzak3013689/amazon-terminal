# Amazon India Product Research Terminal - Environment Configuration Example
# Copy this file to .env to configure custom settings.

# Path to SQLite database file (defaults to data/amazon_research.db)
AMAZON_DB_PATH=data/amazon_research.db

# Optional Keepa API Key (Phase 1 runs in 100% free manual mode without this)
# If provided, enables automated Keepa product data fetches.
KEEPA_API_KEY=

# Default Operating Mode: 'Demo Mode' or 'Real Research Mode'
DEFAULT_OPERATING_MODE=Demo Mode
